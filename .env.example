# Copy to .env and fill in before exposing openGym over the internet.
# See docs/SELF_HOSTING.md for the full guide.

# Your real HTTPS domain, once you put a reverse proxy in front (section 3 of the guide).
# Passkeys are bound to RP_ID, so pick this before people register.
RP_ID=localhost
ORIGIN=http://localhost:8080

# Port the web container publishes on the host.
WEB_PORT=8080

# Shown to users during passkey registration.
RP_NAME=openGym

# Optional: comma-separated user ids that get the admin dashboard (Settings → find your id
# in ./data/db.json under users[].id after your first login).
# ADMIN_UIDS=

# Optional: require an invite code to create a new profile.
# INVITE_ONLY=1

# Optional: how long a login session lasts, in days.
# SESSION_DAYS=90
